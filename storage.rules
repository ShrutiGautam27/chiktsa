rules_version = '2';

// Medical documents are stored in a private bucket and are ONLY accessed through the backend,
// which authorises the request and issues short-lived signed URLs (Phase 4 Document Vault).
// No direct client access, no public URLs.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
