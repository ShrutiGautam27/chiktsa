# ---- CareHub AI web configuration (Vite: only VITE_* values are exposed to the browser) ----
# NEVER put secret API keys (Gemini, email provider, service accounts) in this file.

# Firebase web app config (public identifiers, not secrets). Leave empty to use local auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: shown on the Contact page
VITE_CONTACT_EMAIL=

# Dev only: where the Vite dev server proxies /api (default http://127.0.0.1:8080)
# API_PROXY_TARGET=http://127.0.0.1:8080
