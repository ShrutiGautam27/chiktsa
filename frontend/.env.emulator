# Used by `vite --mode emulator`: Firebase Auth emulator + demo project (local only, not secrets).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-carehub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-carehub
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
