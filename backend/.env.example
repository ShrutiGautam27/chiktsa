# ---- Chiktsa backend configuration ----
ENVIRONMENT=development            # development | test | production
AUTH_PROVIDER=local                # local (dev/demo) | firebase (production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars   # local auth only
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

DATA_STORE=memory                  # memory (dev, persisted to MEMORY_STORE_PATH) | firestore
MEMORY_STORE_PATH=.data/dev-store.json
FIREBASE_PROJECT_ID=               # required when DATA_STORE=firestore or AUTH_PROVIDER=firebase
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  (local only; Cloud Run uses its service account)

CORS_ORIGINS=http://localhost:5391
COOKIE_SECURE=false                # true in production (HTTPS)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
INVITATION_DAYS=7

# ---- Background jobs (Phase 3) ----
JOB_TOKEN=                         # >=32 random chars; required in production (Cloud Scheduler sends it as X-Job-Token)
RUN_SCHEDULER_IN_PROCESS=true      # dev only: runs the reminder tick every SCHEDULER_INTERVAL_SECONDS; set false on Cloud Run
SCHEDULER_INTERVAL_SECONDS=60

# ---- Delivery channels (optional; without them deliveries are recorded as "not configured") ----
EMAIL_PROVIDER=none                # none | resend | sendgrid
EMAIL_API_KEY=
EMAIL_FROM=Chiktsa <no-reply@your-domain>
APP_BASE_URL=http://localhost:5391 # used for links in emails
PUSH_ENABLED=false                 # Firebase Cloud Messaging (needs a Firebase project + web push setup)

# ---- AI (Phase 4) — optional. Without a key every AI workflow runs in labelled offline mode. ----
# Households must ALSO opt in (Household → AI & privacy) before any record is sent to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_HOUR=60

# ---- Document vault storage ----
FILE_STORAGE=local                 # local (dev: backend/.data/files) | gcs (private Firebase Storage bucket)
STORAGE_BUCKET=                    # e.g. <project-id>.appspot.com when FILE_STORAGE=gcs
MAX_UPLOAD_MB=10
